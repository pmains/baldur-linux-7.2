 						    ARRAY_SIZE(args), args);
 	if (IS_ERR(tcsr)) {
 		ret = PTR_ERR(tcsr);
-		if (ret == -ENOENT)
+		/*
+		 * The 4-lane configuration selector is optional. Vendor
+		 * loader DTs may point it at a non-syscon TCSR node; treat
+		 * that like a missing property instead of failing the PHY.
+		 */
+		if (ret == -ENOENT || ret == -ENOTSUPP)
 			return 0;
 
 		dev_err(qmp->dev, "failed to lookup syscon: %d\n", ret);
