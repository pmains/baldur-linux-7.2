+  if (!nlen || nlen>128) return -FDT_ERR_BADVALUE;
+  for (previous=fdt_first_property_offset(fdt,node);previous>=0 && previous!=prop;previous=fdt_next_property_offset(fdt,previous)) {
+   const char *old;
+   if (!*budget) return -FDT_ERR_BADVALUE;
+   --*budget;
+   if (!fdt_getprop_by_offset(fdt,previous,&old,&len) || !strcmp(name,old)) return -FDT_ERR_BADVALUE;
+  }
+  if (previous!=prop) return -FDT_ERR_BADVALUE;
+ }
+ return prop==-FDT_ERR_NOTFOUND?0:prop;
+}
+static inline int OP12_REQUIRED_INIT op12_fdt_unique_properties(const void *fdt,int node)
+{
+ unsigned int budget=32; /* Required nodes permit at most six unique fields. */
+ return op12_fdt_unique_properties_bounded(fdt,node,&budget);
+}
