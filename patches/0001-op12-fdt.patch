+ { int nm,re; const void *p=fdt_getprop(fdt,node,"no-map",&len); nm=p!=0; if (p && len) return -FDT_ERR_BADVALUE; p=fdt_getprop(fdt,node,"reusable",&len); re=p!=0; if (p && len) return -FDT_ERR_BADVALUE; if (nm && re) return -FDT_ERR_BADVALUE; }
