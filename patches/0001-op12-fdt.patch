+}
+static inline int OP12_REQUIRED_INIT op12_required_allocation_result(const void *fdt,int node,int result)
+{
+ int required=op12_required_validate(fdt,node);
+ return required<0?required:required && result?result:0;
+}
+static inline int OP12_REQUIRED_INIT op12_required_queue_result(const void *fdt,int node,unsigned int queued,unsigned int limit)
+{
+ int required=op12_required_validate(fdt,node);
+ return required<0?required:required && queued>=limit?-FDT_ERR_NOSPACE:0;
+}
+static inline int OP12_REQUIRED_INIT op12_required_completion(unsigned int accounted,unsigned int completed)
+{
