+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Embed only an explicitly supplied target DTB; no device/capture discovery."""
+import pathlib,struct,sys
+source,destination=map(pathlib.Path,sys.argv[1:]);data=source.read_bytes()
+if not 40<=len(data)<=2*1024*1024 or data[:4]!=b'\xd0\x0d\xfe\xed' or struct.unpack_from('>I',data,4)[0]!=len(data):raise SystemExit('Invalid/beyond-bound exact target DTB')
+text='/* Generated target template; validated again by bounded libfdt. */\nstatic const unsigned char op12_target_data[] __initconst __aligned(8) = {\n'
+text+='\n'.join(','.join(hex(v)for v in data[i:i+16])+','for i in range(0,len(data),16))+'\n};\n';destination.write_text(text)
