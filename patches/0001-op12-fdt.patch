diff --git a/arch/arm64/kernel/pi/op12-fdt-entry.c b/arch/arm64/kernel/pi/op12-fdt-entry.c
new file mode 100644
--- /dev/null
+++ b/arch/arm64/kernel/pi/op12-fdt-entry.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Default-off experiment; an error stops before any FDT consumers/drivers. */
+#include <linux/init.h>
+#include <linux/types.h>
+#include <linux/limits.h>
+#include <linux/libfdt.h>
+#include <asm/barrier.h>
+#include <asm/sections.h>
+#include "op12-fdt-merge.h"
+#include "op12-target-data.h"
+
+/* Permanent initialized .data, not BSS or initdata. Unflattened OF properties
+ * retain pointers into this blob after free_initmem(). Cost: 2 MiB permanent.
+ * This lies inside the Image idmap, not a bootloader DTB slot. */
+static unsigned char op12_fdt_output[OP12_FDT_CAP] __aligned(8) = { 1 };
+static const char op12_rescue_cmdline[] __initconst = CONFIG_CMDLINE;
+static volatile int op12_fdt_error __initdata = -1;
+static unsigned int op12_fdt_report __initdata;
+
+static void __init __noreturn op12_fdt_stop(int error)
+{
+ op12_fdt_error = error;
+ /* No timer/rescue is established this early. Physical recovery is required. */
+ for (;;) asm volatile("wfe" ::: "memory");
+}
+
+static unsigned int __init op12_original_bound(phys_addr_t original)
+{
+ phys_addr_t start=(phys_addr_t)(unsigned long)_text;
+ phys_addr_t end=(phys_addr_t)(unsigned long)_end;
+ unsigned int bound=OP12_FDT_CAP;
+ if (!original || (original & 7) || original > PHYS_ADDR_MAX-OP12_FDT_CAP ||
+     (original>=start && original<end)) op12_fdt_stop(-2);
+ /* Exact existing map_fdt() clips a below-Image mapping at _text. */
+ if (original<start && start-original<bound) bound=start-original;
+ if (bound<40) op12_fdt_stop(-3);
+ return bound;
+}
+void __init op12_fdt_pointer_check(phys_addr_t original)
+{
+ (void)op12_original_bound(original);
+}
+
+phys_addr_t __init op12_fdt_prepare(phys_addr_t original)
+{
+ int rc = op12_fdt_merge((const void *)(unsigned long)original, op12_original_bound(original),
+  op12_target_data, sizeof(op12_target_data), op12_fdt_output,
+  sizeof(op12_fdt_output), op12_rescue_cmdline, &op12_fdt_report);
+ if (rc) op12_fdt_stop(rc);
+ /* Reserves the original interval and redacts only its seed values after
+  * all fallible operations succeed. Selected entropy remains available. */
+ rc=op12_fdt_retire_original((void *)(unsigned long)original,
+  op12_original_bound(original),op12_fdt_output,sizeof(op12_fdt_output),original);
+ if (rc) op12_fdt_stop(rc);
+ dsb(ishst);
+ op12_fdt_error = 0;
+ return (phys_addr_t)(unsigned long)op12_fdt_output;
+}
