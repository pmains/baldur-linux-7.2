diff --git a/arch/arm64/kernel/pi/op12-fdt-merge.c b/arch/arm64/kernel/pi/op12-fdt-merge.c
new file mode 100644
--- /dev/null
+++ b/arch/arm64/kernel/pi/op12-fdt-merge.c
@@ -0,0 +1,370 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Experimental bounded early-PI merge. No allocations, logging or drivers.
+ * Unknown chosen values and unresolved dynamic reservations fail closed.
+ */
+#ifdef __KERNEL__
+#include <linux/init.h>
+#include <linux/libfdt.h>
+#define OP12_INIT __init
+#define OP12_DATA __initconst
+#define OP12_WORK __initdata
+#else
+#include <libfdt.h>
+#include <stdint.h>
+#include <string.h>
+#define OP12_INIT
+#define OP12_DATA
+#define OP12_WORK
+#endif
+#include "op12-fdt-merge.h"
+#ifdef __KERNEL__
+#include <linux/op12_fdt_required.h>
+#else
+#include "op12_fdt_required.h"
+#endif
+#define TRY(x) do { int _r = (x); if (_r < 0) return _r; } while (0)
+#define BAD(x) do { if (!(x)) return -FDT_ERR_BADVALUE; } while (0)
+
+/* Primary-CPU-only scratch: integers, no pointers/heap/absolute relocations.
+ * A bounded open-addressed set replaces repeated whole-tree handle lookups. */
+static unsigned int validation_handles[16384] OP12_WORK = {1};
+static int OP12_INIT valid(const void *p, unsigned int bound)
+{
+ int at = 0, next = 0, depth = -1, roots = 0, nodes = 0;
+ unsigned int total, comparisons=2097152, probes=65536;
+ int parents[65], chosen_count=0, reserved_count=0, reserved_node=-1;
+ memset(validation_handles,0,sizeof(validation_handles));
+ BAD(bound >= sizeof(struct fdt_header) && bound <= OP12_FDT_CAP);
+ TRY(fdt_check_header(p)); BAD(fdt_version(p)==17); total = fdt_totalsize(p);
+ BAD(total >= sizeof(struct fdt_header) && total <= bound);
+ for (;;) {
+  unsigned int tag = fdt_next_tag(p, at, &next);
+  TRY(next); BAD(next > at && (unsigned int)next <= fdt_size_dt_struct(p));
+  if (tag == FDT_BEGIN_NODE) {
+   int len; const char *name=fdt_get_name(p,at,&len);
+   BAD(name && len>=0 && len<=128 && ++nodes<=8192); BAD(++depth<=64);
+   parents[depth]=at;
+   if (depth==0) { BAD(len==0); ++roots; }
+   TRY(op12_fdt_unique_properties_bounded(p,at,&comparisons));
+   if (depth==1) {
+    BAD(strncmp(name,"chosen@",7) && strncmp(name,"reserved-memory@",16));
+    if (!strcmp(name,"chosen")) BAD(++chosen_count==1);
+    if (!strcmp(name,"reserved-memory")) { BAD(++reserved_count==1); reserved_node=at; }
+   }
+   if ((depth==2 && parents[1]==reserved_node) ||
+       (depth==1 && fdt_getprop(p,at,"device_type",&len)))
+    BAD(fdt_subnode_offset_namelen(p,parents[depth-1],name,(int)strlen(name))==at);
+   { const fdt32_t *ph=fdt_getprop(p,at,"phandle",&len); unsigned int handle=0;
+    if (ph) { BAD(len==4); handle=fdt32_ld(ph); BAD(handle && handle!=0xffffffffU); }
+    ph=fdt_getprop(p,at,"linux,phandle",&len);
+    if (ph) { unsigned int old; BAD(len==4); old=fdt32_ld(ph); BAD(old && old!=0xffffffffU && (!handle || old==handle)); handle=old; }
+    if (handle) {
+     unsigned int slot=(handle*2654435761U)&16383U;
+     while (validation_handles[slot]) { BAD(probes-- && validation_handles[slot]!=handle); slot=(slot+1)&16383U; }
+     BAD(probes--); validation_handles[slot]=handle;
+    }
+   }
+  }
+  else if (tag == FDT_END_NODE) { BAD(depth >= 0); --depth; }
+  else if (tag == FDT_PROP) { int len; const char *name; BAD(depth>=0 && fdt_getprop_by_offset(p,at,&name,&len) && len>=0); }
+  else if (tag == FDT_END) { BAD(depth == -1 && roots == 1); break; }
+  else BAD(tag == FDT_NOP);
+  at = next;
+ }
+ TRY(fdt_num_mem_rsv(p));
+ return 0;
+}
+static int OP12_INIT noalias(const void *a, unsigned int as, const void *b, unsigned int bs)
+{
+ unsigned long x = (unsigned long)a, y = (unsigned long)b;
+ BAD(x + as >= x && y + bs >= y);
+ BAD(x + as <= y || y + bs <= x); return 0;
+}
+static int OP12_INIT two_cells(const void *p, int node)
+{
+ int n; const fdt32_t *v;
+ v = fdt_getprop(p,node,"#address-cells",&n); BAD(v && n==4 && fdt32_to_cpu(*v)==2);
+ v = fdt_getprop(p,node,"#size-cells",&n); BAD(v && n==4 && fdt32_to_cpu(*v)==2);
+ return 0;
+}
+static int OP12_INIT flag(const void *p,int node,const char *name)
+{
+ int n; const void *v=fdt_getprop(p,node,name,&n);
+ if (!v) return n == -FDT_ERR_NOTFOUND ? 0 : n;
+ return n == 0 ? 1 : -FDT_ERR_BADVALUE;
+}
+static int OP12_INIT interval(const void *raw,int n,uint64_t *base,uint64_t *size)
+{
+ const fdt64_t *v=raw;
+ BAD(v && n==16); *base=fdt64_ld(v); *size=fdt64_ld(v+1);
+ BAD(*base + *size >= *base); return 0;
+}
+static int OP12_INIT root_memory(const void *boot,void *out)
+{
+ int node=-1,depth=-1,found=0,dst,n; const char *type; const void *reg;
+ /* Drop template memory nodes. Fresh original banks alone are authoritative. */
+ while ((node=fdt_node_offset_by_prop_value(out,-1,"device_type","memory",7))>=0)
+  { BAD(fdt_parent_offset(out,node)==0); TRY(fdt_del_node(out,node)); }
+ BAD(node == -FDT_ERR_NOTFOUND);
+ dst=fdt_add_subnode(out,0,"memory"); TRY(dst);
+ TRY(fdt_setprop(out,dst,"device_type","memory",7));
+ for (node=fdt_next_node(boot,-1,&depth);node>=0 && depth>=0;node=fdt_next_node(boot,node,&depth)) {
+  type=fdt_getprop(boot,node,"device_type",&n);
+  if (!type || n!=7 || memcmp(type,"memory",7)) continue;
+  BAD(depth==1 && ++found<=8);
+  { int po;
+   for (po=fdt_first_property_offset(boot,node);po>=0;po=fdt_next_property_offset(boot,po)) {
+    int length; const char *key; BAD(fdt_getprop_by_offset(boot,po,&key,&length));
+    if (strcmp(key,"device_type") && strcmp(key,"reg") && strcmp(key,"status") && strcmp(key,"phandle") && strcmp(key,"linux,phandle") && strcmp(key,"ddr_device_type")) return -FDT_ERR_BADVALUE;
+   }
+   BAD(po==-FDT_ERR_NOTFOUND);
+  }
+  { int len; const char *status=fdt_getprop(boot,node,"status",&len);
+   BAD(!status || (len==5 && !memcmp(status,"okay",5)) || (len==3 && !memcmp(status,"ok",3)));
+  }
+  reg=fdt_getprop(boot,node,"reg",&n);
+  BAD(reg && n>0 && n%16==0 && n<=1024);
+  for (int at=0;at<n;at+=16) { uint64_t base,size; TRY(interval((const char *)reg+at,16,&base,&size)); }
+  TRY(fdt_appendprop(out,dst,"reg",reg,n));
+ }
+ BAD((node==-FDT_ERR_NOTFOUND || depth<0) && found);
+ reg=fdt_getprop(out,dst,"reg",&n); BAD(reg && n>0 && n<=1024);
+ { int positive=0;
+  for (int at=0;at<n;at+=16) { uint64_t b,s; TRY(interval((const char *)reg+at,16,&b,&s));
+   if (!s) continue; ++positive;
+   for (int prev=0;prev<at;prev+=16) { uint64_t pb,ps; TRY(interval((const char *)reg+prev,16,&pb,&ps)); BAD(!ps || b>=pb+ps || pb>=b+s); }
+  }
+  BAD(positive);
+ }
+ return 0;
+}
+static int OP12_INIT copy_reserve_map(const void *boot,void *out)
+{
+ int n=fdt_num_mem_rsv(boot); TRY(n); BAD(n<=64);
+ for (int i=0;i<n;++i) { uint64_t b,s; TRY(fdt_get_mem_rsv(boot,i,&b,&s)); BAD(s && b+s>=b); TRY(fdt_add_mem_rsv(out,b,s)); }
+ return 0;
+}
+/* Exact opt-in Waffle RAM-rescue exceptions: NOT a generic flag relaxation. */
+static int OP12_INIT enabled(const void *fdt,int node)
+{
+ while (node>=0) {
+  int len; const char *s=fdt_getprop(fdt,node,"status",&len);
+  if (s && !((len==5 && !memcmp(s,"okay",5)) || (len==3 && !memcmp(s,"ok",3)))) return 0;
+  node=fdt_parent_offset(fdt,node);
+ }
+ return 1;
+}
+static int OP12_INIT no_active_memory_consumer(const void *fdt,int region)
+{
+ unsigned int handle=fdt_get_phandle(fdt,region); int node=-1,depth=-1;
+ if (!handle) return 1;
+ for (node=fdt_next_node(fdt,-1,&depth);node>=0 && depth>=0;node=fdt_next_node(fdt,node,&depth)) {
+  int len; const fdt32_t *v=fdt_getprop(fdt,node,"memory-region",&len);
+  if (!v) continue;
+  if (len%4) return 0;
+  for (int i=0;i<len/4;++i) if (fdt32_ld(v+i)==handle && enabled(fdt,node)) return 0;
+ }
+ return node==-FDT_ERR_NOTFOUND || depth<0;
+}
+static int OP12_INIT reviewed_exception(const void *fdt,int other,uint64_t b,uint64_t s,int nm,int re,
+ uint64_t ob,uint64_t os,int onm,int ore)
+{
+ if (nm || !onm || ore || !no_active_memory_consumer(fdt,other)) return 0;
+ if (re && ob==b && os==s &&
+     ((b==0x82800000ULL && s==0x2000000ULL) ||
+      (b==0xf3800000ULL && s==0x4400000ULL) ||
+      (b==0xf7c00000ULL && s==0x4c00000ULL))) return 1;
+ return !re && b==0x81ce4000ULL && s==0x10000ULL &&
+        ob==0x81c80000ULL && os==0x75000ULL;
+}
+static int OP12_INIT fixed_covered(const void *out,int parent,uint64_t b,uint64_t s,int nm,int re,unsigned int *report)
+{
+ int other,overlaps=0,exceptions=0,count=0; uint64_t cursor=b,end=b+s;
+ for (other=fdt_first_subnode(out,parent);other>=0;other=fdt_next_subnode(out,other)) {
+  uint64_t ob,os; int len,onm,ore; const void *reg=fdt_getprop(out,other,"reg",&len);
+  BAD(++count<=128); if (!enabled(out,other) || !reg) continue; TRY(interval(reg,len,&ob,&os));
+  if (!os || b>=ob+os || ob>=end) continue; ++overlaps;
+  onm=flag(out,other,"no-map"); ore=flag(out,other,"reusable"); TRY(onm); TRY(ore);
+  if (onm!=nm || ore!=re) {
+   if (!reviewed_exception(out,other,b,s,nm,re,ob,os,onm,ore)) return OP12_FDT_RESERVATION_CONFLICT;
+   ++exceptions;
+  }
+ }
+ BAD(other==-FDT_ERR_NOTFOUND);
+ if (!overlaps) return 0;
+ if (exceptions) {
+  if (overlaps!=1) return OP12_FDT_RESERVATION_CONFLICT;
+  *report|=OP12_FDT_FIXED_FEATURES_DEFERRED; return 1;
+ }
+ /* Same-flag union coverage, overflow checked by interval(). */
+ while (cursor<end) {
+  uint64_t furthest=cursor;
+  for (other=fdt_first_subnode(out,parent);other>=0;other=fdt_next_subnode(out,other)) {
+   uint64_t ob,os; int len; const void *reg=fdt_getprop(out,other,"reg",&len);
+   if (!enabled(out,other) || !reg) continue; TRY(interval(reg,len,&ob,&os));
+   if (os && ob<=cursor && ob+os>furthest) furthest=ob+os;
+  }
+  BAD(other==-FDT_ERR_NOTFOUND);
+  if (furthest==cursor) return OP12_FDT_RESERVATION_CONFLICT;
+  cursor=furthest;
+ }
+ return 1;
+}
+static int OP12_INIT dynamic_copy(const void *boot,int node,void *out,unsigned int *count,uint64_t *total)
+{
+ int n,prop,nm,re,parent,added; const void *size,*alignment,*ranges;
+ uint64_t bytes,align=4096; const char *name=fdt_get_name(boot,node,&n);
+ static const char known[][32] OP12_DATA={"qseecom_region","qseecom_ta_region","qmc_dma_region","non_secure_display_region","vm_comm_mem_region","va_md_mem_region","sp_region","cdsp_eva_region","adsp_heap_region","linux,cma","secure_cdsp_region","debug_kinfo_region","ramoops_region","mem_dump_region","cnss_wlan_region"};
+ int recognized=0;
+ for (unsigned int i=0;i<sizeof(known)/sizeof(known[0]);++i) if (!strcmp(name,known[i])) recognized=1;
+ BAD(recognized && ++*count<=16);
+ for (prop=fdt_first_property_offset(boot,node);prop>=0;prop=fdt_next_property_offset(boot,prop)) {
+  const char *key; const void *v=fdt_getprop_by_offset(boot,prop,&key,&n); BAD(v && n>=0);
+  if (!strcmp(key,"size") || !strcmp(key,"alignment") || !strcmp(key,"alloc-ranges") || !strcmp(key,"no-map") || !strcmp(key,"reusable") || !strcmp(key,"phandle") || !strcmp(key,"linux,phandle")) continue;
+  if (!strcmp(key,"compatible")) {
+   BAD((n==16 && !memcmp(v,"shared-dma-pool",16)) || (n==8 && !memcmp(v,"ramoops",8))); continue;
+  }
+  if (!strcmp(key,"linux,cma-default")) { BAD(n==0 && !strcmp(name,"linux,cma")); continue; }
+  if (!strcmp(name,"ramoops_region") && (!strcmp(key,"pmsg-size") || !strcmp(key,"console-size") || !strcmp(key,"mem-type"))) { BAD(n==4); continue; }
+  return OP12_FDT_DYNAMIC_UNRESOLVED;
+ }
+ BAD(prop==-FDT_ERR_NOTFOUND);
+ size=fdt_getprop(boot,node,"size",&n); BAD(size && n==8); bytes=fdt64_ld(size);
+ BAD(bytes && bytes<=0x10000000ULL && *total<=0x20000000ULL-bytes); *total+=bytes;
+ nm=flag(boot,node,"no-map"); re=flag(boot,node,"reusable"); TRY(nm); TRY(re); BAD(!(nm&&re));
+ alignment=fdt_getprop(boot,node,"alignment",&n);
