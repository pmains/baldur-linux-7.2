+/* Bounded duplicate-property rejection shared by PI and required OF hooks. */
+static inline int OP12_REQUIRED_INIT op12_fdt_unique_properties_bounded(const void *fdt,int node,unsigned int *budget)
+{
+ int prop,count=0;
+ for (prop=fdt_first_property_offset(fdt,node);prop>=0;prop=fdt_next_property_offset(fdt,prop)) {
+  int len,previous,nlen=0; const char *name;
+  if (++count>2048 || !fdt_getprop_by_offset(fdt,prop,&name,&len) || len<0) return -FDT_ERR_BADVALUE;
