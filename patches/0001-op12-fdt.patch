+}
+static inline int OP12_REQUIRED_INIT op12_required_account(const void *fdt,int node,unsigned int *count,uint64_t *total)
+{
+ int result=op12_required_validate(fdt,node),len; const fdt64_t *v; uint64_t size;
+ if (result<=0) return result;
