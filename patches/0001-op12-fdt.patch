+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef OP12_FDT_REQUIRED_H
+#define OP12_FDT_REQUIRED_H
+/* Internal opt-in preservation tag; not a vendor binding or consumer link. */
+#ifdef __KERNEL__
+#include <linux/init.h>
+#include <linux/libfdt.h>
+#define OP12_REQUIRED_INIT __init
